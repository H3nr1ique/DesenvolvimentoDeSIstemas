programa {
    inclua biblioteca Matematica --> mat
    
    funcao inicio() {
        cadeia nome
        real salarioAtual, salarioReajustado
        
        escreva("======================================================\n")
        escreva("=== REAJUSTE SALARIAL - AYRton SENNA FUTEBOL CLUBE ===\n")
        escreva("======================================================\n\n")

            escreva("Digite o nome do jogador: ")
            leia(nome)
            
            escreva("Digite o salário atual (R$): ")
            leia(salarioAtual)
            
            // Cálculo do reajuste
            se (salarioAtual <= 5000.00) {
                salarioReajustado = salarioAtual * 1.20
            } senao se (salarioAtual <= 8000.00) {
                salarioReajustado = salarioAtual * 1.10
            } senao {
                salarioReajustado = salarioAtual // 0% de aumento
            }
            
            // Arredondando 2 casas decimais
            salarioAtual = mat.arredondar(salarioAtual, 2)
            salarioReajustado = mat.arredondar(salarioReajustado, 2)
            
            // Exibição dos resultados
            escreva("\n-----------------")
            escreva("\n--- RESULTADO ---\n")
            escreva("-----------------\n\n")
            escreva("Jogador: ", nome, "\n")
            escreva("Salário Atual: R$ ", salarioAtual, "\n")
            escreva("Salário Reajustado: R$ ", salarioReajustado, "\n")
            escreva("Aumento: R$ ", mat.arredondar(salarioReajustado - salarioAtual, 2), "\n\n")
        }
    }
}
